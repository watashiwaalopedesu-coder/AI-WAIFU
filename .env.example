# Copy to .env.local. Never put keys in NEXT_PUBLIC_* variables.
# demo | openai | openrouter | compatible
CHAT_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_MODELS=gpt-4.1-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_MODELS=
# Optional compatible server (e.g. http://127.0.0.1:11434/v1)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_MODELS=
